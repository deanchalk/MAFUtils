<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Session-scoped SQL Server metadata catalogs and dependency graph tools for Microsoft Agent Framework and .NET applications.</Description>
    <Version>0.6.0</Version>
    <IsPackable>true</IsPackable>
    <PackageId>MAFUtils.SqlServer</PackageId>
    <Authors>Dean Chalk</Authors>
    <Copyright>Copyright (c) 2026 Dean Chalk</Copyright>
    <PackageProjectUrl>https://github.com/deanchalk/MAFUtils/blob/main/MAFUtils/MAFUtils.SqlServer/README.md</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deanchalk/MAFUtils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing public APIs are not yet fully documented. Ship available XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Dependency graph fixes, built-in schema filtering, an agent refresh opt-out and support for reflection-free JSON. See CHANGELOG.md in the repository for compatibility notes.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>MicrosoftAgentFramework;AI;SqlServer;Tools</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Fail packing on unintended breaking changes to the published public API. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.5.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <!-- Override SqlClient's transitive version for the October 2026 security fixes. Remove once SqlClient's own dependency is at least this version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
